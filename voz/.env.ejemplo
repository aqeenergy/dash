# Copiad este archivo como .env y poned vuestra clave. El .env NUNCA se sube a GitHub.
# Clave gratuita: https://aistudio.google.com/apikey
GEMINI_API_KEY=

# Opcionales
# Principal y reservas, separados por comas (si uno falla se pasa al siguiente)
MODELO_LIVE=gemini-3.1-flash-live-preview,gemini-2.5-flash-native-audio-preview-12-2025
MODELO_EMBEDDINGS=gemini-embedding-001
VOZ=Kore
NOMBRE_ASISTENTE=Llama

# Protección de la cuota compartida
MAX_SESIONES_SIMULTANEAS=3
MAX_SESIONES_IP_HORA=30
MAX_MINUTOS_SESION=15

# Si la IA se queda callada a mitad de respuesta, segundos antes de darle un toque
SEGUNDOS_ATASCO=10

# La IA lleva el catálogo de tablas en sus instrucciones (respuestas más rápidas)
CATALOGO_EN_PROMPT=si
